{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "相机测试：模拟自检（无需相机）",
            "type": "shell",
            "command": "python run_test.py --simulate --duration 15",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "相机测试：真实相机 60s",
            "type": "shell",
            "command": "python run_test.py --duration 60",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "相机测试：平场+暗场 180s",
            "type": "shell",
            "command": "python run_test.py --duration 180 --dark-field",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "相机测试：枚举设备",
            "type": "shell",
            "command": "python run_test.py --list",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "相机测试：单元测试",
            "type": "shell",
            "command": "python -m unittest discover -s tests -v",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
